{
  "name": "anime-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ANIME FORGE - code-driven Japanese-style 2D anime production system",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=production tsx tests/run.ts && NODE_ENV=production tsx tests/factory.ts",
    "validate": "tsx scripts/validate-episode.ts",
    "studio": "remotion studio src/index.ts",
    "editor": "vite --config vite.editor.config.ts",
    "build": "tsc --noEmit && vite build --config vite.editor.config.ts",
    "render:test": "tsx scripts/render.ts test5",
    "render:sample": "tsx scripts/render.ts sample30",
    "render:ep": "tsx scripts/render.ts episode",
    "verify:video": "tsx scripts/verify-video.ts",
    "build:data": "tsx scripts/build-sample.ts && tsx scripts/build-episode.ts",
    "audio:placeholder": "tsx scripts/gen-placeholder-audio.ts",
    "render:episode": "tsx scripts/render-episode.ts",
    "render:episode:concat": "tsx scripts/render-episode.ts --concat-only",
    "check": "npm run typecheck && npm test && npm run validate",
    "still": "tsx scripts/shotstill.tsx",
    "production:audit": "tsx scripts/production/cli.ts audit",
    "production:status": "tsx scripts/production/cli.ts status",
    "production:storyboard": "tsx scripts/production/cli.ts storyboard",
    "production:preview": "tsx scripts/production/cli.ts preview",
    "production:render-shot": "tsx scripts/production/cli.ts render-shot",
    "production:render-scene": "tsx scripts/production/cli.ts render-scene",
    "production:render-all": "tsx scripts/production/cli.ts render-all",
    "production:resume": "tsx scripts/production/cli.ts resume",
    "production:qa": "tsx scripts/production/cli.ts qa",
    "production:assemble": "tsx scripts/production/cli.ts assemble",
    "production:report": "tsx scripts/production/cli.ts report",
    "production:finalize": "tsx scripts/production/cli.ts finalize",
    "production:approve": "tsx scripts/production/cli.ts approve",
    "production:voices": "tsx scripts/production/voices.ts",
    "production:audio": "tsx scripts/production/cli.ts audio"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.535",
    "@remotion/cli": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.535"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  }
}