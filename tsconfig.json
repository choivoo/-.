  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true, "esModuleInterop": true, "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"], "noUnusedLocals": false
